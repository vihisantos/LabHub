{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabHub TV",
  "version": "2.4.0",
  "identifier": "br.com.labhub.tv",
  "build": {
    "dev-url": "http://localhost:5173",
    "before-dev-command": "",
    "before-build-command": "",
    "frontend-dist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LabHub TV",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": false,
        "minWidth": 1920,
        "minHeight": 1080,
        "maxWidth": 1920,
        "maxHeight": 1080,
        "decorations": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "src-tauri/icons/icon.ico",
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/128x128@2x.png",
      "src-tauri/icons/384x384.png",
      "src-tauri/icons/1024x1024.png"
    ]
  }
}