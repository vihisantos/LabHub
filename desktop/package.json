{
  "name": "labhub-tv-desktop",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Lab Hub TV — display corporativo em kiosk para TVs (Electron)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env TV_DESKTOP_DEV=1 electron .",
    "start": "electron .",
    "build:renderer": "cd .. && npx vite build --config vite.desktop.config.ts",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:portable": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.labhub.tv",
    "productName": "Lab Hub TV",
    "files": [
      "electron/**/*",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../public/logo-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "LabHub-TV-${version}-setup.exe"
    },
    "portable": {
      "artifactName": "LabHub-TV-${version}-portable.exe"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
