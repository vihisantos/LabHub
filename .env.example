# Supabase — copie para .env e preencha os valores
# Obtenha em: https://app.supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Versão do app (opcional, exibida nas Configurações)
VITE_APP_VERSION=2.1.0

# Supabase JWT Secret — usado pelo backend Flask para verificar tokens JWT.
# Se não configurado e python-jose estiver instalado, usa JWKS (recomendado).
# Se JWKS falhar e esta variável estiver definida, usa verificação HMAC.
# Obtenha em: https://app.supabase.com → seu projeto → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Upstash Redis — notificações push via Flask backend
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL base da API Flask do ReservaLab (opcional — vazio = mesmo domínio)
# Usada pelos apps (reservas) e pelo envio de push do admin (POST /api/push/send).
# Se o frontend e a API estiverem no mesmo domínio Vercel, deixe vazio.
VITE_RESERVALAB_API_URL=

# VAPID — chave pública para Web Push (frontend se inscrever)
VITE_VAPID_PUBLIC_KEY=

# Cloudinary — upload de imagens/vídeos (TV)
# Obtenha suas credenciais em: https://console.cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Preset dedicado para avatares de usuários (pasta "avatars" no Cloudinary).
# Uploads unsigned ignoram o parâmetro folder, então cada preset define sua pasta.
VITE_CLOUDINARY_UPLOAD_PRESET_AVATARS=
# CLOUDINARY_API_KEY e CLOUDINARY_API_SECRET são usadas pelo backend Python
# para deletar imagens automaticamente quando removidas da galeria.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeatherMap — clima no display da TV (gratuito: https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=
VITE_OPENWEATHER_CITY=SuaCidade,BR

# ── App desktop Lab Hub TV (Electron) ──
# Base da API Flask/Serverless (Vercel). Na web é '' (same-origin).
# No build desktop, aponte para o deploy: https://<projeto>.vercel.app
VITE_TV_API_BASE=
# URL do painel administrativo que o botão "Painel" abre (no navegador padrão)
VITE_TV_ADMIN_URL=
# URL de download do instalador desktop (opcional — fallback: GitHub release latest)
VITE_TV_INSTALLER_URL=

# ── Variáveis do backend Flask (ReservaLab) ──
# Usadas no deploy Vercel do backend, não no frontend.
# A planilha de cada campus é configurada no workspace (Configurar workspace →
# Apps do workspace) e salva em workspaces.spreadsheet_url no Supabase.
# SHAREPOINT_URL é OPCIONAL — só serve de fallback global quando um campus não
# tem planilha própria. A URL precisa ter ?download=1 para forçar download direto.
# SHAREPOINT_URL=https://suaempresa-my.sharepoint.com/...?download=1
# SUPABASE_URL=...
# SUPABASE_SERVICE_KEY=...

# Token do "Zerar dados" (endpoint POST /api/admin/wipe — apaga dados operacionais
# de stock/pcare/chamados/tv no Supabase). VITE_WIPE_TOKEN é a cópia usada pelo
# frontend no botão de reset. Gere com: openssl rand -hex 24
WIPE_TOKEN=
VITE_WIPE_TOKEN=

# CRON_SECRET — protege GET /api/push/check-all (crons). Quando configurada no
# Vercel, o Cron Job envia automaticamente `Authorization: Bearer ${CRON_SECRET}`
# e o endpoint só responde com esse header. Sem ela, o endpoint fica aberto.
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Resend — envio de emails (relatório semanal de chamados)
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=
# Remetente do email (deve ser um domínio verificado no Resend)
EMAIL_FROM=LabHub <labhub@resend.dev>
